# Backblaze B2 Account Configuration
# Copy this file to accounts.yaml and replace with actual credentials.
# Bucket is auto-discovered (first bucket per account via B2 API).
# capacity_gb is the total storage limit for the account.

accounts:
  my-account:
    account_id: "your_application_key_id_here"
    master_key: "your_application_key_here"
    capacity_gb: 10