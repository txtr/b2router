# Backblaze B2 Account Configuration
# Copy to accounts.yaml and replace with actual credentials.
# Bucket is auto-discovered (first bucket per account via B2 API).
# capacity_gb is the total storage limit for the account.

accounts:
  backblaze0000:
    account_id: ""
    master_key: ""
    capacity_gb: 10

  backblaze0001:
    account_id: ""
    master_key: ""
    capacity_gb: 10